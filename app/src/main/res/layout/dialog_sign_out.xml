<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="300dp"
    android:background="@drawable/bg_dialog"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvSignOutQuestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Really want to\nsign out?"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSignOutOk"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/vibrant_red"
        android:text="OK"
        android:textColor="@color/white"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toStartOf="@id/btnSignOutCancel"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSignOutQuestion" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSignOutCancel"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:backgroundTint="@color/vibrant_red"
        android:text="Cancel"
        android:textColor="@color/white"
        app:cornerRadius="28dp"
        app:layout_constraintBottom_toBottomOf="@id/btnSignOutOk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSignOutOk"
        app:layout_constraintTop_toTopOf="@id/btnSignOutOk" />

</androidx.constraintlayout.widget.ConstraintLayout>